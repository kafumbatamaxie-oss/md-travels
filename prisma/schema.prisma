generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * **************                     ********
 * ================= CUSTOMERS =================
 */
model Customer {
  id String @id @default(uuid())

  name String

  email String

  phone String?

  companyId String?

  company Company? @relation(fields: [companyId], references: [id])

  quotes Quote[]

  bookings Booking[]

  createdAt DateTime @default(now())
}

/**
 * ================= SERVICES =================
 */
model Service {
  id String @id @default(uuid())

  name String
  slug String @unique

  description String?

  category     ServiceCategory
  pricingModel PricingModel

  active   Boolean @default(true)
  featured Boolean @default(false)

  basePrice    Float?
  perKmPrice   Float?
  perHourPrice Float?
  perDayPrice  Float?

  minimumCharge Float?

  coverImage String?

  vehicles ServiceVehicle[]
  images   ServiceImage[]

  bookings Booking[]

  displayOrder Int @default(0)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  quoteItems QuoteItem[]
}

model ServiceImage {
  id String @id @default(uuid())

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  url      String
  publicId String

  order Int @default(0)

  createdAt DateTime @default(now())
}

enum PricingModel {
  FIXED
  DISTANCE
  HOURLY
  HALF_DAY
  FULL_DAY
  CUSTOM
}

enum ServiceCategory {
  AIRPORT_TRANSFER

  CORPORATE

  EVENT

  WEDDING

  VIP

  TOUR

  SHUTTLE

  STAFF

  SCHOOL

  CHAUFFEUR
}

/**
 * ================= VEHICLES =================
 */

model Vehicle {
  id String @id @default(uuid())

  name String

  slug String @unique

  description String?

  type String

  capacity Int

  luggageCapacity Int?

  basePrice   Float?
  perKmPrice  Float?
  perDayPrice Float?

  airConditioning Boolean @default(true)
  wifi            Boolean @default(false)
  executive       Boolean @default(false)

  featured Boolean @default(false)
  active   Boolean @default(true)

  coverImage String?

  status VehicleStatus

  services   ServiceVehicle[]
  bookings   Booking[]
  quoteItems QuoteItem[]

  images VehicleImage[]

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  DISABLED
}

/**
 * =============Vehicle Image
 */
model VehicleImage {
  id String @id @default(uuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url      String
  publicId String

  order Int @default(0)

  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model ServiceVehicle {
  serviceId String
  vehicleId String

  service Service @relation(fields: [serviceId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@id([serviceId, vehicleId])
}

/**
 * ================= DRIVERS =================
 */

model Driver {
  id String @id @default(uuid())

  name  String
  phone String

  license     String?
  licenseType String?

  status DriverStatus

  maxDailyHours Int @default(10)

  bookings Booking[]

  rating Float?

  notes String?

  createdAt DateTime @default(now())
}

enum DriverStatus {
  ACTIVE
  OFF_DUTY
  ON_LEAVE
  SUSPENDED
}

/**
 * ================= QUOTES =================
 */
model Quote {
  id String @id @default(uuid())

  quoteNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status QuoteStatus

  totalPrice Float

  expiresAt DateTime?

  items QuoteItem[]

  bookings Booking[] // ← ADD THIS (fix)

  invoices Invoice[]

  createdAt DateTime @default(now())

  @@index([customerId])
}

enum QuoteStatus {
  PENDING
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

model QuoteItem {
  id String @id @default(uuid())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  description String?

  passengers Int

  pickup      String?
  destination String?

  startDate DateTime?
  endDate   DateTime?

  distanceKm Float?

  price Float
}

/**
 * ================= BOOKING =================
 */

model Booking {
  id String @id @default(uuid())

  bookingRef String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  passengers Int

  pickup String

  durationMinutes Int?

  distanceKm Float?

  pickupPlaceId String?

  destination String?

  destinationPlaceId String?

  startDate DateTime
  endDate   DateTime?

  price Float

  status BookingStatus

  invoices Invoice[]

  createdAt DateTime @default(now())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  event     Event?   @relation(fields: [eventId], references: [id])
  eventId   String?

  pickupAddress String
  pickupLat     Float?
  pickupLng     Float?

  destinationAddress String?
  destinationLat     Float?
  destinationLng     Float?

  pickupDate String?
  kupTime    String?

  notes String?

  @@index([vehicleId, startDate, endDate]) // ADD THIS
}

enum BookingStatus {
  NEW
  QUOTED
  RESERVED
  CONFIRMED
  DRIVER_ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/**
 * =============== Company ======================
 */
model Company {
  id String @id @default(uuid())

  name String

  email String?

  phone String?

  address String?

  vatNumber String?

  customers Customer[]

  bookings Booking[]

  createdAt DateTime @default(now())
}

/**
 * Event  *
 */
model Event {
  id String @id @default(uuid())

  name String

  eventType EventType

  location String?

  startDate DateTime

  endDate DateTime?

  bookings Booking[]

  createdAt DateTime @default(now())
}

enum EventType {
  WEDDING
  CORPORATE
  CONFERENCE
  SCHOOL
  PRIVATE
  TOUR
}

/**
 * ================= INVOICE =================
 */

model Invoice {
  id String @id @default(uuid())

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  amount Float

  pdfUrl String?

  issuedAt DateTime @default(now())
}

// 
model BookingDraft {
  id String @id @default(uuid())

  pickup      String
  destination String

  distanceKm  Float?
  durationMin Int?

  vehicleId String?
  // vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  estimatedPrice Float?

  createdAt DateTime @default(now())
}
