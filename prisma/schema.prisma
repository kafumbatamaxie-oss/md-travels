generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// *
///  * **************                     ********
///  * ================= CUSTOMERS =================
model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String
  phone     String?
  companyId String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
  company   Company?  @relation(fields: [companyId], references: [id])
  quotes    Quote[]
}

/// *
///  * ================= SERVICES =================
model Service {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique
  description   String?
  category      ServiceCategory
  active        Boolean          @default(true)
  pricingModel  PricingModel
  basePrice     Float?
  perKmPrice    Float?
  perHourPrice  Float?
  perDayPrice   Float?
  minimumCharge Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  coverImage    String?
  displayOrder  Int              @default(0)
  featured      Boolean          @default(false)
  bookings      Booking[]
  quoteItems    QuoteItem[]
  images        ServiceImage[]
  vehicles      ServiceVehicle[]
}

model ServiceImage {
  id        String   @id @default(uuid())
  serviceId String
  url       String
  publicId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id              String           @id @default(uuid())
  name            String
  type            String
  capacity        Int
  basePrice       Float?
  perKmPrice      Float?
  perDayPrice     Float?
  status          VehicleStatus
  luggageCapacity Int?
  airConditioning Boolean          @default(true)
  wifi            Boolean          @default(false)
  executive       Boolean          @default(false)
  featured        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  sortOrder       Int              @default(0)
  active          Boolean          @default(true)
  coverImage      String?
  description     String?
  slug            String           @unique
  updatedAt       DateTime         @updatedAt
  bookings        Booking[]
  quoteItems      QuoteItem[]
  services        ServiceVehicle[]
  images          VehicleImage[]
}

/// *
///  * =============Vehicle Image
model VehicleImage {
  id        String   @id @default(uuid())
  vehicleId String
  url       String
  publicId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model ServiceVehicle {
  serviceId String
  vehicleId String
  service   Service @relation(fields: [serviceId], references: [id])
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@id([serviceId, vehicleId])
}

model Driver {
  id            String       @id @default(uuid())
  name          String
  phone         String
  license       String?
  licenseType   String?
  status        DriverStatus
  maxDailyHours Int          @default(10)
  rating        Float?
  notes         String?
  createdAt     DateTime     @default(now())
  bookings      Booking[]
}

/// *
///  * ================= QUOTES =================
model Quote {
  id          String      @id @default(uuid())
  quoteNumber String      @unique
  customerId  String
  status      QuoteStatus
  totalPrice  Float
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  bookings    Booking[]
  invoices    Invoice[]
  customer    Customer    @relation(fields: [customerId], references: [id])
  items       QuoteItem[]

  @@index([customerId])
}

model QuoteItem {
  id          String    @id @default(uuid())
  quoteId     String
  serviceId   String
  vehicleId   String?
  description String?
  passengers  Int
  pickup      String?
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  distanceKm  Float?
  price       Float
  quote       Quote     @relation(fields: [quoteId], references: [id])
  service     Service   @relation(fields: [serviceId], references: [id])
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
}

model Booking {
  id                 String        @id @default(uuid())
  bookingRef         String        @unique
  customerId         String
  vehicleId          String
  driverId           String?
  serviceId          String
  quoteId            String?
  passengers         Int
  pickup             String
  durationMinutes    Int?
  distanceKm         Float?
  pickupPlaceId      String?
  destination        String?
  destinationPlaceId String?
  startDate          DateTime
  endDate            DateTime?
  price              Float
  status             BookingStatus
  createdAt          DateTime      @default(now())
  companyId          String?
  eventId            String?
  destinationAddress String?
  destinationLat     Float?
  destinationLng     Float?
  notes              String?
  pickupAddress      String
  pickupLat          Float?
  pickupLng          Float?
  company            Company?      @relation(fields: [companyId], references: [id])
  customer           Customer      @relation(fields: [customerId], references: [id])
  driver             Driver?       @relation(fields: [driverId], references: [id])
  event              Event?        @relation(fields: [eventId], references: [id])
  quote              Quote?        @relation(fields: [quoteId], references: [id])
  service            Service       @relation(fields: [serviceId], references: [id])
  vehicle            Vehicle       @relation(fields: [vehicleId], references: [id])
  invoices           Invoice[]

  @@index([vehicleId, startDate, endDate])
}

/// *
///  * =============== Company ======================
model Company {
  id        String     @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  vatNumber String?
  createdAt DateTime   @default(now())
  bookings  Booking[]
  customers Customer[]
}

/// *
///  * Event  *
model Event {
  id        String    @id @default(uuid())
  name      String
  eventType EventType
  location  String?
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Invoice {
  id        String   @id @default(uuid())
  quoteId   String?
  bookingId String?
  amount    Float
  pdfUrl    String?
  issuedAt  DateTime @default(now())
  booking   Booking? @relation(fields: [bookingId], references: [id])
  quote     Quote?   @relation(fields: [quoteId], references: [id])
}

model BookingDraft {
  id             String   @id @default(uuid())
  pickup         String
  destination    String
  distanceKm     Float?
  durationMin    Int?
  vehicleId      String?
  estimatedPrice Float?
  createdAt      DateTime @default(now())
}

enum PricingModel {
  FIXED
  DISTANCE
  HOURLY
  HALF_DAY
  FULL_DAY
  CUSTOM
}

enum ServiceCategory {
  AIRPORT_TRANSFER
  CORPORATE
  EVENT
  WEDDING
  VIP
  TOUR
  SHUTTLE
  STAFF
  SCHOOL
  CHAUFFEUR
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  DISABLED
}

enum DriverStatus {
  ACTIVE
  OFF_DUTY
  ON_LEAVE
  SUSPENDED
}

enum QuoteStatus {
  PENDING
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum BookingStatus {
  NEW
  QUOTED
  RESERVED
  CONFIRMED
  DRIVER_ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EventType {
  WEDDING
  CORPORATE
  CONFERENCE
  SCHOOL
  PRIVATE
  TOUR
}
